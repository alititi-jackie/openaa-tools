---
import BaseLayout from "./BaseLayout.astro";
import { guides, type Guide } from "../data/guides";
import { tools } from "../data/tools";
interface Props {
  guide: Guide;
}
const { guide } = Astro.props;
const tool = tools.find((t) => t.id === guide.toolIds[0])!;
const path = guide.path!;
const same = guides.filter(
  (g) => g.slug !== guide.slug && g.toolIds.includes(tool.id),
);
const cross = guides.filter(
  (g) =>
    g.toolIds[0] !== tool.id &&
    tools.find((t) => t.id === g.toolIds[0])?.category === tool.category,
);
const related = [...same.slice(0, 4), ...cross.filter((g, i) => i % 10 === 0)];
const sources = guide.sources || [];
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: guide.title,
  description: guide.description,
  inLanguage: "zh-CN",
  mainEntityOfPage: `https://tools.openaa.com${path}`,
  author: { "@type": "Organization", name: "OpenAA" },
  publisher: {
    "@type": "Organization",
    name: "OpenAA",
    url: "https://openaa.com",
  },
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "工具库",
      item: "https://tools.openaa.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: tool.name,
      item: `https://tools.openaa.com${tool.path}`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: guide.title,
      item: `https://tools.openaa.com${path}`,
    },
  ],
};
---

<BaseLayout
  title={guide.title}
  description={guide.description}
  canonical={path}
  bodyClass="guide-page"
  ogType="article"
>
  <Fragment slot="head"
    ><script
      type="application/ld+json"
      set:html={JSON.stringify(articleSchema).replace(/</g, "\\u003c")}
    /><script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumb).replace(/</g, "\\u003c")}
    /></Fragment
  >
  <div class="guide-shell">
    <aside class="guide-tool">
      <a href={tool.path}>→ {tool.name}</a><p>
        先用工具检查自己的材料，再看下面的中文解释。
      </p>
    </aside><nav class="guide-breadcrumb" aria-label="面包屑">
      <a href="/">全部工具</a> / <a href={tool.path}>{tool.name}</a> / 攻略
    </nav><article class="guide-article">
      <h1>{guide.title}</h1><p class="guide-lead">{guide.intro}</p><p
        class="guide-note"
      >
        官方规则核对：{guide.reviewed} · OpenAA 中文整理
      </p><div class="guide-content">
        {
          guide.sections.map((s) => (
            <section>
              <>
                <h2>{s.heading}</h2>
                <Fragment set:html={s.html} />
              </>
            </section>
          ))
        }<section>
          <h2>常见问题</h2>{
            guide.faq.map((f) => (
              <>
                <>
                  <h3>{f.question}</h3>
                  <p>{f.answer}</p>
                </>
              </>
            ))
          }
        </section><section>
          <h2>检查我的材料</h2><p>
            <a href={tool.path}>→ 使用{tool.name}</a
            >。按需要继续使用下面的相关工具。
          </p><ul>
            {
              tools
                .filter((t) => t.category === tool.category && t.id !== tool.id)
                .map((t) => (
                  <li>
                    <a href={t.path}>{t.name}</a>
                  </li>
                ))
            }
          </ul>
        </section><section>
          <h2>官方来源与适用范围</h2><p>{guide.scope}</p><ul>
            {
              sources.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener noreferrer">
                    {s.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div><section class="guide-related">
        <h2>相关文章</h2>{related.map((g) => <a href={g.path}>{g.title} →</a>)}
      </section>
    </article>
  </div>
</BaseLayout>
<style>
  .guide-shell {
    max-width: 860px;
    margin: auto;
    padding: 16px 16px 48px;
  }
  .guide-tool {
    padding: 16px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 14px;
    margin-bottom: 18px;
  }
  .guide-tool a {
    font-size: 18px;
    font-weight: 700;
    color: #1d4ed8;
  }
  .guide-tool p {
    margin: 8px 0 0;
    line-height: 1.6;
  }
  .guide-breadcrumb {
    font-size: 14px;
    margin-bottom: 18px;
    line-height: 1.7;
  }
  .guide-article {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: clamp(18px, 4vw, 36px);
  }
  h1 {
    font-size: clamp(25px, 5vw, 36px);
    line-height: 1.35;
    margin: 0 0 16px;
  }
  h2 {
    font-size: 22px;
    margin-top: 30px;
  }
  h3 {
    font-size: 18px;
  }
  .guide-content p,
  .guide-lead {
    line-height: 1.9;
    color: #334155;
  }
  .guide-content li {
    line-height: 1.9;
    margin-bottom: 8px;
  }
  .guide-note {
    font-size: 14px;
    color: #64748b;
  }
  .guide-related a {
    display: block;
    padding: 14px 0;
    border-bottom: 1px solid #e5e7eb;
    line-height: 1.7;
  }
  a {
    overflow-wrap: anywhere;
  }
</style>
