---
import BaseLayout from "./BaseLayout.astro";
import { guides, type Guide } from "../data/guides";
import { tools } from "../data/tools";
interface Props {
  guide: Guide;
}
const { guide } = Astro.props;
const tool = tools.find((t) => t.id === guide.toolIds[0])!;
const path = guide.path!;
const lang = guide.lang ?? "zh";
const htmlLang = lang === "zh" ? "zh-CN" : lang;
const localizedToolNames: Record<string, { en: string; es: string }> = {
  "parking-qr": { en: "Parking QR Code", es: "Código QR de estacionamiento" },
};
const toolName =
  lang === "zh" ? tool.name : (localizedToolNames[tool.id]?.[lang] ?? tool.name);
const L = {
  zh: { crumbLabel: "面包屑", home: "工具库", allTools: "全部工具", guideWord: "攻略", aside: "先用工具检查自己的材料，再看下面的中文解释。", faq: "常见问题", check: "检查我的材料", usePrefix: "→ 使用", checkTail: "。按需要继续使用下面的相关工具。", sourcesTitle: "官方来源与适用范围", related: "相关文章" },
  en: { crumbLabel: "Breadcrumb", home: "Tools", allTools: "All tools", guideWord: "Guide", aside: "Try the free tool first, then read the explanation below.", faq: "Frequently asked questions", check: "Try it yourself", usePrefix: "→ Use the ", checkTail: ". Then browse the related tools below if you need more.", sourcesTitle: "Official sources and scope", related: "Related guides" },
  es: { crumbLabel: "Ruta de navegación", home: "Herramientas", allTools: "Todas las herramientas", guideWord: "Guía", aside: "Prueba primero la herramienta gratuita y luego lee la explicación.", faq: "Preguntas frecuentes", check: "Pruébalo tú mismo", usePrefix: "→ Usa ", checkTail: ". Después revisa también las herramientas relacionadas.", sourcesTitle: "Fuentes oficiales y alcance", related: "Guías relacionadas" },
}[lang];
const noteText =
  lang === "zh"
    ? `官方规则核对：${guide.reviewed} · OpenAA 中文整理`
    : lang === "en"
      ? `Checked against official sources: ${guide.reviewed} · Compiled by OpenAA`
      : `Verificado con fuentes oficiales: ${guide.reviewed} · Recopilado por OpenAA`;
const same = guides.filter(
  (g) => g.slug !== guide.slug && g.toolIds.includes(tool.id),
);
const cross = guides.filter(
  (g) =>
    g.toolIds[0] !== tool.id &&
    tools.find((t) => t.id === g.toolIds[0])?.category === tool.category,
);
const sameSorted = [...same].sort(
  (a, b) => Number((b.lang ?? "zh") === lang) - Number((a.lang ?? "zh") === lang),
);
const related = [
  ...sameSorted.slice(0, 4),
  ...cross.filter(
    (g, i) =>
      cross.findIndex((other) => other.toolIds[0] === g.toolIds[0]) === i,
  ),
];
const sources = guide.sources || [];
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: guide.title,
  description: guide.description,
  inLanguage: htmlLang,
  mainEntityOfPage: `https://tools.openaa.com${path}`,
  author: { "@type": "Organization", name: "OpenAA" },
  publisher: {
    "@type": "Organization",
    name: "OpenAA",
    url: "https://openaa.com",
  },
};
import { guideEcoLink } from "../data/eco-links";
const eco = guideEcoLink(guide.slug);
const ecoFinal =
  lang === "zh"
    ? eco
    : {
        url: `https://openaa.com/?utm_source=tools.openaa.com&utm_medium=referral&utm_campaign=${guide.slug}`,
        label: lang === "en" ? "Visit OpenAA.com" : "Visita OpenAA.com",
        title: lang === "en" ? "From the OpenAA community" : "De la comunidad OpenAA",
        description:
          lang === "en"
            ? "OpenAA.com is a community platform for life in the US — jobs, housing, a marketplace and local services."
            : "OpenAA.com es una comunidad en línea sobre la vida en EE. UU.: empleo, vivienda, compraventa y servicios locales.",
      };
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: L.home,
      item: "https://tools.openaa.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: toolName,
      item: `https://tools.openaa.com${tool.path}`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: guide.title,
      item: `https://tools.openaa.com${path}`,
    },
  ],
};
---

<BaseLayout
  title={guide.title}
  description={guide.description}
  canonical={path}
  bodyClass="guide-page"
  ogType="article"
  lang={htmlLang}
>
  <Fragment slot="head"
    ><script
      type="application/ld+json"
      set:html={JSON.stringify(articleSchema).replace(/</g, "\\u003c")}
    /><script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumb).replace(/</g, "\\u003c")}
    /></Fragment
  >
  <div class="guide-shell">
    <aside class="guide-tool">
      <a href={tool.path}>→ {toolName}</a><p>
        {L.aside}
      </p>
    </aside><nav class="guide-breadcrumb" aria-label={L.crumbLabel}>
      <a href="/">{L.allTools}</a> / <a href={tool.path}>{toolName}</a> / {L.guideWord}
    </nav><article class="guide-article">
      <h1>{guide.title}</h1><p class="guide-lead">{guide.intro}</p><p
        class="guide-note"
      >
        {noteText}
      </p><div class="guide-content">
        {
          guide.sections.map((s) => (
            <section>
              <>
                <h2>{s.heading}</h2>
                <Fragment set:html={s.html} />
              </>
            </section>
          ))
        }<section>
          <h2>{L.faq}</h2>{
            guide.faq.map((f) => (
              <>
                <>
                  <h3>{f.question}</h3>
                  <p>{f.answer}</p>
                </>
              </>
            ))
          }
        </section><section>
          <h2>{L.check}</h2><p>
            <a href={tool.path}>{L.usePrefix}{toolName}</a
            >{L.checkTail}
          </p><ul>
            {
              tools
                .filter((t) => t.category === tool.category && t.id !== tool.id)
                .map((t) => (
                  <li>
                    <a href={t.path}>{t.name}</a>
                  </li>
                ))
            }
          </ul>
        </section><section>
          <h2>{L.sourcesTitle}</h2><p>{guide.scope}</p><ul>
            {
              sources.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener noreferrer">
                    {s.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div><section class="guide-related">
        <h2>{L.related}</h2>{related.map((g) => <a href={g.path}>{g.title} →</a>)}
      </section>
      <section class="guide-eco">
        <h2>{ecoFinal.title}</h2>
        <p>
          {ecoFinal.description}
          <a href={ecoFinal.url} target="_blank" rel="noopener noreferrer"
            >{ecoFinal.label} →</a
          >
        </p>
      </section>
    </article>
  </div>
</BaseLayout>
<style>
  .guide-eco {
    margin-top: 28px;
    padding: 20px;
    border: 1px solid #bfdbfe;
    border-radius: 14px;
    background: #eff6ff;
  }
  .guide-eco h2 {
    margin: 0 0 8px;
    font-size: 18px;
  }
  .guide-eco p {
    margin: 0;
    color: #475569;
    font-size: 14px;
  }
  .guide-eco a {
    font-weight: 700;
    color: #2563eb;
  }
  .guide-shell {
    max-width: 860px;
    margin: auto;
    padding: 16px 16px 48px;
  }
  .guide-tool {
    padding: 16px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 14px;
    margin-bottom: 18px;
  }
  .guide-tool a {
    font-size: 18px;
    font-weight: 700;
    color: #1d4ed8;
  }
  .guide-tool p {
    margin: 8px 0 0;
    line-height: 1.6;
  }
  .guide-breadcrumb {
    font-size: 14px;
    margin-bottom: 18px;
    line-height: 1.7;
  }
  .guide-article {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: clamp(18px, 4vw, 36px);
  }
  h1 {
    font-size: clamp(25px, 5vw, 36px);
    line-height: 1.35;
    margin: 0 0 16px;
  }
  h2 {
    font-size: 22px;
    margin-top: 30px;
  }
  h3 {
    font-size: 18px;
  }
  .guide-content p,
  .guide-lead {
    line-height: 1.9;
    color: #334155;
  }
  .guide-content li {
    line-height: 1.9;
    margin-bottom: 8px;
  }
  .guide-note {
    font-size: 14px;
    color: #64748b;
  }
  .guide-related a {
    display: block;
    padding: 14px 0;
    border-bottom: 1px solid #e5e7eb;
    line-height: 1.7;
  }
  a {
    overflow-wrap: anywhere;
  }
</style>
