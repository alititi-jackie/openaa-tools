---
import BaseLayout from './BaseLayout.astro';
import { guides, type Guide } from '../data/guides';
interface Props { guide: Guide }
const { guide }=Astro.props;
const path=`/usa/dmv/${guide.slug}/`;
const related=guides.filter(g=>g.slug!==guide.slug && g.toolIds.some(id=>guide.toolIds.includes(id))).slice(0,6);
const articleSchema={"@context":"https://schema.org","@type":"Article",headline:guide.title,description:guide.description,inLanguage:"zh-CN",mainEntityOfPage:`https://tools.openaa.com${path}`,publisher:{"@type":"Organization",name:"OpenAA",url:"https://openaa.com"}};
const breadcrumb={"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"工具库",item:"https://tools.openaa.com/"},{"@type":"ListItem",position:2,name:"DMV 与证件",item:"https://tools.openaa.com/?category=dmv"},{"@type":"ListItem",position:3,name:guide.title,item:`https://tools.openaa.com${path}`} ]};
---
<BaseLayout title={guide.title} description={guide.description} canonical={path} bodyClass="guide-page">
<Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(articleSchema).replace(/</g,'\\u003c')}/><script type="application/ld+json" set:html={JSON.stringify(breadcrumb).replace(/</g,'\\u003c')}/><style>.guide-shell{max-width:860px;margin:0 auto;padding:18px 16px 48px}.guide-breadcrumb{font-size:14px;margin:4px 0 18px;color:#64748b}.guide-breadcrumb a{color:inherit}.guide-article{background:#fff;border:1px solid #e5e7eb;border-radius:16px;padding:clamp(20px,4vw,36px)}.guide-article h1{font-size:clamp(26px,5vw,38px);line-height:1.25;margin:0 0 16px}.guide-lead{font-size:17px;line-height:1.8;color:#334155}.guide-tool{margin:24px 0;padding:18px;border-radius:14px;background:#eff6ff;border:1px solid #bfdbfe}.guide-tool strong{display:block;font-size:18px;margin-bottom:6px}.guide-tool a{display:inline-block;margin-top:10px;font-weight:700}.guide-content h2{font-size:22px;margin:30px 0 10px}.guide-content p{line-height:1.85;color:#334155}.guide-related{margin-top:24px}.guide-related a{display:block;padding:13px 0;border-bottom:1px solid #e5e7eb}.guide-note{margin-top:28px;font-size:14px;color:#64748b}</style></Fragment>
<div class="guide-shell"><nav class="guide-breadcrumb"><a href="/">全部工具</a> / <a href="/?category=dmv">DMV 与证件</a> / 指南</nav><article class="guide-article"><h1>{guide.title}</h1><p class="guide-lead">{guide.intro}</p><aside class="guide-tool"><strong>纽约 DMV 6 Points 计算器</strong><span>不确定自己的材料够不够？按身份证明、地址证明、其它加分证明快速检查。</span><br/><a href="/usa/dmv/6-points-calculator.html">立即检查我的材料 →</a></aside><div class="guide-content">{guide.sections.map(s=><section><h2>{s.heading}</h2><Fragment set:html={s.html}/></section>)}</div><p class="guide-note">本文用于帮助中文用户理解和准备材料，不代替纽约 DMV 的最终审核。证件要求可能更新，办理前请同时核对最新 ID-44 和 DMV Document Guide。</p>{related.length>0&&<section class="guide-related"><h2>纽约 DMV 相关指南</h2>{related.map(g=><a href={`/usa/dmv/${g.slug}/`}>{g.title} →</a>)}</section>}</article></div>
</BaseLayout>