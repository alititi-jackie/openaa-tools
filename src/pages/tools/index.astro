---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolCard from "../../components/tools/ToolCard.astro";
import { tools, categories } from "../../data/tools";
---

<BaseLayout
  title="全部工具"
  description="浏览 OpenAA 工具库全部 41 个工具，按美国生活、工资理财、DMV、汽车和单位换算分类查找，也可搜索工具名称快速进入。"
  modules={["catalog"]}
  ><div class="container catalog">
    <div class="page-heading">
      <span class="eyebrow">OPENAA 工具库</span><h1>全部工具</h1><p>
        按关键词或分类，找到需要的 {tools.length} 个实用工具。
      </p>
    </div><div class="search-form">
      <label class="sr-only" for="tool-search">搜索工具</label><input
        id="tool-search"
        type="search"
        placeholder="输入工具名称或关键词…"
        autocomplete="off"
      /><button type="button" id="clear-search">清除</button>
    </div><nav class="filter-bar" aria-label="工具分类">
      <a href="/tools/" data-filter="all" aria-current="true">全部</a>{
        categories.map((c) => (
          <a href={`/tools/?category=${c.id}`} data-filter={c.id}>
            {c.icon} {c.name}
          </a>
        ))
      }
    </nav><p id="tool-count" class="catalog-count" role="status">
      共 {tools.length} 个工具
    </p><div id="tool-grid" class="tool-grid">
      {tools.map((tool) => <ToolCard tool={tool} />)}
    </div><p id="empty-state" hidden>
      没有找到匹配的工具，试试其他关键词或选择“全部”。
    </p>
  </div></BaseLayout
>
