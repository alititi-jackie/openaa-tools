---
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolCard from "../components/tools/ToolCard.astro";
import { tools, categories } from "../data/tools";
import { homeEcoLinks } from "../data/eco-links";
const ecoLinks = homeEcoLinks();
---

<BaseLayout
  title="美国生活免费在线工具大全"
  description="OpenAA 工具库提供 41 个免费中文工具，按美国生活、日常生活、DMV 与证件、汽车出行、单位换算、工资与理财分类浏览，支持搜索，无需注册。"
  modules={["catalog"]}
>
  <div class="container catalog">
    <div class="page-heading">
      <h1>OpenAA 工具库</h1>
      <p>{tools.length} 个免费中文工具，按分类查找，打开就能用。</p>
    </div>
    <div class="search-form" role="search">
      <label class="sr-only" for="tool-search">搜索工具</label>
      <input
        id="tool-search"
        type="search"
        placeholder="搜索工具，例如：小费、记账、DMV"
        autocomplete="off"
      />
      <button type="button" id="clear-search">清除</button>
    </div>
    <nav class="filter-bar" aria-label="工具分类">
      <a href="/" data-filter="all" aria-current="true">全部</a>
      {
        categories.map((c) => (
          <a href={`/?category=${c.id}`} data-filter={c.id}>
            {c.icon} {c.name}
          </a>
        ))
      }
    </nav>
    <p id="tool-count" class="catalog-count" role="status">
      共 {tools.length} 个工具
    </p>
    <div id="tool-groups">
      {
        categories.map((c) => {
          const items = tools.filter((t) => t.category === c.id);
          return (
            <section
              class="tool-group"
              data-group={c.id}
              aria-labelledby={`category-${c.id}`}
            >
              <div class="group-heading">
                <h2 id={`category-${c.id}`}>
                  <span aria-hidden="true">{c.icon}</span> {c.name}
                </h2>
                <span class="group-count" data-group-count>
                  {items.length} 个工具
                </span>
              </div>
              <div class="tool-grid">
                {items.map((tool) => (
                  <ToolCard tool={tool} />
                ))}
              </div>
            </section>
          );
        })
      }
    </div>
    <p id="empty-state" hidden>
      没有找到匹配的工具，试试其他关键词或选择“全部”。
    </p>
    <section class="eco-hub" aria-label="OpenAA 生态入口">
      <h2>工具之外，生活继续</h2>
      <p>找工作、找房、二手、本地服务、新闻、DMV 题库、手机靓号，直接进入。</p>
      <div class="eco-hub-grid">
        {
          ecoLinks.map((l) => (
            <a href={l.url} target="_blank" rel="noopener noreferrer">
              {l.label} →
            </a>
          ))
        }
      </div>
    </section>
  </div>
  <style>
    .eco-hub {
      margin: 40px 0 8px;
      padding: 24px;
      border: 1px solid #e5e7eb;
      border-radius: 16px;
      background: #f8fafc;
    }
    .eco-hub h2 {
      margin: 0 0 6px;
      font-size: 20px;
    }
    .eco-hub p {
      margin: 0 0 14px;
      color: #64748b;
      font-size: 14px;
    }
    .eco-hub-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .eco-hub-grid a {
      padding: 10px 18px;
      border-radius: 999px;
      background: #fff;
      border: 1px solid #e2e8f0;
      font-weight: 700;
      font-size: 14px;
      text-decoration: none;
      color: #0f172a;
    }
    .eco-hub-grid a:hover {
      border-color: #2563eb;
      color: #2563eb;
    }
  </style>
</BaseLayout>
