---
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolCard from "../components/tools/ToolCard.astro";
import { tools, categories } from "../data/tools";
import { homeEcoCards } from "../data/eco-links";
const ecoCards = homeEcoCards();
---

<BaseLayout
  title="美国生活免费在线工具大全"
  description="OpenAA 工具库提供 41 个免费中文工具，按美国生活、日常生活、DMV 与证件、汽车出行、单位换算、工资与理财分类浏览，支持搜索，无需注册。"
  modules={["catalog"]}
>
  <div class="container catalog">
    <div class="page-heading">
      <h1>OpenAA 工具库</h1>
      <p>{tools.length} 个免费中文工具，按分类查找，打开就能用。</p>
    </div>
    <section id="engage-recent" class="engage-section" hidden>
      <div class="recent-heading">
        <h2>🕘 最近使用</h2>
        <button type="button" class="clear-recent" data-clear-recent aria-label="清空最近使用">清空</button>
      </div>
      <div class="tool-grid" id="engage-recent-grid"></div>
    </section>
    <section id="engage-fav" class="engage-section" hidden>
      <h2>⭐ 我的收藏</h2>
      <div class="tool-grid" id="engage-fav-grid"></div>
    </section>
    <script
      type="application/json"
      id="openaa-tool-index"
      set:html={JSON.stringify(
        tools.map((t) => ({
          id: t.id,
          name: t.name,
          path: t.path,
          description: t.description,
          icon: t.icon,
        })),
      ).replace(/</g, "\\u003c")}
    />
    <div class="search-form" role="search">
      <label class="sr-only" for="tool-search">搜索工具</label>
      <input
        id="tool-search"
        type="search"
        placeholder="搜索工具，例如：小费、记账、DMV"
        autocomplete="off"
      />
      <button type="button" id="clear-search">清除</button>
    </div>
    <nav class="filter-bar" aria-label="工具分类">
      <a href="/" data-filter="all" aria-current="true">全部</a>
      {
        categories.map((c) => (
          <a href={`/?category=${c.id}`} data-filter={c.id}>
            {c.icon} {c.name}
          </a>
        ))
      }
    </nav>
    <p id="tool-count" class="catalog-count" role="status">
      共 {tools.length} 个工具
    </p>
    <div id="tool-groups">
      {
        categories.map((c) => {
          const items = tools.filter((t) => t.category === c.id);
          return (
            <section
              class="tool-group"
              data-group={c.id}
              aria-labelledby={`category-${c.id}`}
            >
              <div class="group-heading">
                <h2 id={`category-${c.id}`}>
                  <span aria-hidden="true">{c.icon}</span> {c.name}
                </h2>
                <span class="group-count" data-group-count>
                  {items.length} 个工具
                </span>
              </div>
              <div class="tool-grid">
                {items.map((tool) => (
                  <ToolCard tool={tool} />
                ))}
              </div>
            </section>
          );
        })
      }
    </div>
    <p id="empty-state" hidden>
      没有找到匹配的工具，试试其他关键词或选择“全部”。
    </p>
    <section class="tool-group eco-cards" aria-label="更多 OpenAA 服务">
      <div class="group-heading">
        <h2>更多 OpenAA 服务</h2>
      </div>
      <p class="eco-sub">工具之外，OpenAA 还有这些在美华人生活服务。</p>
      <div class="tool-grid">
        {
          ecoCards.map((c) => (
            <a
              class="tool-card"
              href={c.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="tool-icon" aria-hidden="true">
                {c.icon}
              </span>
              <div>
                <h3>{c.title}</h3>
                <p>{c.description}</p>
              </div>
              <span class="card-arrow" aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
  <style>
    .recent-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
    }
    .recent-heading h2 { margin: 0; }
    .clear-recent {
      flex-shrink: 0;
      min-width: 44px;
      min-height: 44px;
      padding: 8px 10px;
      border: 0;
      border-radius: 8px;
      background: transparent;
      color: #64748b;
      font: inherit;
      font-size: 14px;
      cursor: pointer;
    }
    .clear-recent:hover { background: #f1f5f9; color: #334155; }
    .clear-recent:focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; }
    .eco-cards {
      margin-bottom: 8px;
    }
    .eco-sub {
      margin: -6px 0 14px;
      color: #64748b;
      font-size: 14px;
    }
  </style>
</BaseLayout>
