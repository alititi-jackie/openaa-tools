---
import { site } from "../../config/site";
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="OpenAA 工具库首页"
      ><img src="/assets/openaa-logo.png" width="36" height="36" alt="" /><span
        ><b><em>Open</em>AA</b><small>工具库</small></span
      ></a
    >
    <nav class="site-nav" aria-label="主导航">
      <a href="/" aria-current={path === "/" ? "page" : undefined}>首页</a><a
        href="/tools/"
        aria-current={path.startsWith("/tools/") ? "page" : undefined}
        >全部工具</a
      ><a href={site.parent} target="_blank" rel="noopener noreferrer"
        >返回 OpenAA ↗</a
      >
    </nav>
    <button
      class="share-button"
      data-share
      aria-label="分享当前页面"
      title="分享"
      ><svg
        width="19"
        height="19"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
        ><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"
        ></circle><circle cx="18" cy="19" r="3"></circle><path
          d="m8.6 10.5 6.8-4M8.6 13.5l6.8 4"></path></svg
      ></button
    >
  </div>
</header>
