---
import { site } from "../../config/site";
---

<footer class="site-footer">
  <p><strong>OpenAA 工具库</strong> · 让美国生活更方便</p><nav
    aria-label="页脚导航"
  >
    <a href={site.parent} target="_blank" rel="noopener noreferrer"
      >OpenAA.com</a
    ><a href="https://dmv.openaa.com/" target="_blank" rel="noopener noreferrer"
      >DMV 各州题库</a
    ><a href="https://numbermobi.com/" target="_blank" rel="noopener noreferrer"
      >美国手机靓号</a
    ><a href="/privacy/">隐私说明</a><a
      href={`${site.parent}/feedback`}
      target="_blank"
      rel="noopener noreferrer">意见反馈</a
    >
  </nav><button type="button" class="footer-install" data-install>添加到桌面</button>
  <small>© {new Date().getFullYear()} OpenAA · 免费使用，无需注册</small>
</footer>

<style>
  .footer-install {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    margin: 2px auto 14px;
    padding: 7px 15px;
    border: 1px solid #dbe3ee;
    border-radius: 999px;
    background: #fff;
    color: #475569;
    font-size: 13px;
    cursor: pointer;
  }
  .footer-install:hover {
    border-color: #bfdbfe;
    color: #1d4ed8;
  }
  .footer-install:focus-visible {
    outline: 2px solid #93c5fd;
    outline-offset: 2px;
  }
</style>
