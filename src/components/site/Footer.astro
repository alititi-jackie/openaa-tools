---
const ECO_ROW = [
  { label: "OpenAA · 主站", href: "https://openaa.com/" },
  { label: "DMV题库", href: "https://dmv.openaa.com/" },
  { label: "Tools工具", href: null },
  { label: "EN英语", href: "https://en.openaa.com/" },
  { label: "Go导航", href: "https://go.openaa.com/" },
  { label: "NumberMobi · 手机靓号", href: "https://numbermobi.com/" },
];
---

<footer class="site-footer">
  <nav aria-label="页脚导航">
    <a href="/about/">关于本站</a><a href="/privacy/">隐私政策</a><a
      href="https://go.openaa.com/feedback/?site=tools"
      target="_blank"
      rel="noopener noreferrer">联系与反馈</a
    ><button type="button" class="footer-install" data-install>添加到桌面</button>
  </nav>
  <nav aria-label="OpenAA 生态">
    {
      ECO_ROW.map((l) =>
        l.href ? (
          <a href={l.href} target="_blank" rel="noopener noreferrer">
            {l.label}
          </a>
        ) : (
          <span class="eco-self" aria-current="true">
            {l.label}
          </span>
        ),
      )
    }
  </nav>
  <small>© {new Date().getFullYear()} OpenAA · Tools工具 · 美国华人工具，让美国生活更方便</small>
</footer>

<style>
  .footer-install {
    font: inherit;
    color: #475569;
    background: none;
    border: none;
    padding: 0 6px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }
  .footer-install:hover {
    color: #1d4ed8;
  }
  .footer-install:focus-visible {
    outline: 2px solid #93c5fd;
    outline-offset: 2px;
  }
  .eco-self {
    color: #1e293b;
    font-weight: 600;
  }
</style>
