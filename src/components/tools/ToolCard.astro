---
import CategoryIcon from "./CategoryIcon.astro";
import type { Tool } from "../../data/tools";
interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
---

<a
  class="tool-card"
  href={tool.path}
  data-category={tool.category}
  data-search={`${tool.name} ${tool.description} ${tool.id}`.toLowerCase()}
  ><span class="tool-icon" aria-hidden="true"
    ><CategoryIcon category={tool.category} /></span
  ><div>
    <h3>{tool.name}</h3><p>{tool.description}</p>
  </div><span class="card-arrow" aria-hidden="true">↗</span></a
>
