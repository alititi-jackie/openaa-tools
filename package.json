{
  "name": "openaa-tools",
  "version": "1.0.0",
  "description": "OpenAA 旗下中文在线工具库",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests docs *.json *.mjs",
    "validate": "npm run check && npm test && npm run build && python3 scripts/validate-site.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alititi-jackie/openaa-tools.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/alititi-jackie/openaa-tools/issues"
  },
  "homepage": "https://github.com/alititi-jackie/openaa-tools#readme",
  "dependencies": {
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.58.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  },
  "private": true
}
